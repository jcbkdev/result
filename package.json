{
  "name": "@jcbkdev/result",
  "version": "0.3.0",
  "type": "module",
  "description": "A Result type for TypeScript that makes errors explicit in function signatures",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "keywords": [
    "result",
    "error-handling",
    "typescript"
  ],
  "sideEffects": false,
  "author": "jcbkdev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcbkdev/result.git"
  },
  "license": "MIT",
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
